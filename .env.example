LOG_LEVEL=info

# SQLite database path. Use :memory: for throwaway tests.
# 安装包模式下，install.sh 会默认把它写成 ~/.local/share/codex-feishu-imui/imui.db
IMUI_DB_PATH=.data/imui.db

# Optional runtime directories.
IMUI_CONFIG_DIR=
IMUI_DATA_DIR=
IMUI_ASSET_CACHE_DIR=
IMUI_BACKUP_DIR=

# Optional runtime retention knobs.
IMUI_ASSET_TTL_HOURS=168
IMUI_ASSET_MAX_MB=1024
IMUI_BACKUP_RETENTION_DAYS=14

# stdin: local NDJSON loop for development
# long_conn: real Feishu long connection mode
# off: disable inbound events entirely
FEISHU_MODE=stdin
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional. Recommended in group chats so first-message @bot detection is stable.
FEISHU_BOT_OPEN_ID=

# Optional Feishu/Lark endpoints. Defaults target Feishu China.
# For Lark global, set FEISHU_API_BASE_URL=https://open.larksuite.com/open-apis
# FEISHU_WS_BASE_URL defaults to the origin of FEISHU_API_BASE_URL.
# FEISHU_WS_ENDPOINT_URL defaults to FEISHU_WS_BASE_URL + /callback/ws/endpoint.
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_WS_BASE_URL=
FEISHU_WS_ENDPOINT_URL=

# Codex app-server is launched via `codex app-server --stdio` by this service.
# CODEX_BASE_URL / CODEX_USERNAME / CODEX_PASSWORD are kept only for compatibility and are normally unused.
CODEX_BASE_URL=
CODEX_USERNAME=
CODEX_PASSWORD=

# Default directory / workspace / agent / model used for new sessions.
# Prefer absolute paths for CODEX_DIRECTORY.
# CODEX_MODEL format: [<provider>/]<model_id>[@<variant>]
CODEX_DIRECTORY=
CODEX_WORKSPACE=
CODEX_AGENT=
CODEX_MODEL=

# Optional runtime override.
# You can also pass: codex-feishu-imui --env-file /path/to/.env
# IMUI_ENV_FILE=
